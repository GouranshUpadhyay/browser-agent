# Copy this file to a new file named exactly:  .env   (same folder)
# Never commit .env — it holds your secrets. This example file must only contain placeholders.

# Required: your Gemini key from aistudio.google.com
GOOGLE_API_KEY=paste-your-key-here

# Optional: change the model without touching code
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Security ---
# Browser origins allowed to call the API (comma-separated)
# CORS_ORIGINS=http://localhost:5173
# If set, every API call needs "Authorization: Bearer <token>". Put the same value in
# frontend/.env.local as VITE_API_TOKEN=... (fine for a private setup, not a public website).
# API_TOKEN=
# Restrict which sites the agent may open (comma-separated, wildcards allowed)
# ALLOWED_DOMAINS=*.flipkart.com,*.amazon.in,*.google.com,*.wikipedia.org

# --- Runs ---
# MAX_CONCURRENT_RUNS=2
# MAX_STEPS=25
# SQLite by default; Postgres works too, e.g. postgresql+psycopg://user:pass@localhost/agent
# DATABASE_URL=sqlite:///./agent.db

# --- Automations ---
# DEFAULT_TIMEZONE=Asia/Kolkata
# A run missed while the server was off still happens if it is at most this many minutes late
# MISSED_RUN_GRACE_MINUTES=60

# --- Telegram notifications (optional) ---
# 1. Talk to @BotFather in Telegram, create a bot, paste its token here.
# 2. Send your bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Link used in notifications to open a run in the app
# APP_URL=http://localhost:5173
